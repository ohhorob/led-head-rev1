			(embedded_fonts no)
		)
	)
	(text "PAC1934: 4 x high-side shunt measurements per IC, 3.3 V supply and I/O.\nU4 address 0x10: ADDRSEL tied to GND. U5 address 0x1F: ADDRSEL tied to VDD.\nSLOW pulled low through 10k and PWRDN held high. Do not configure SLOW as an ALERT output."
		(exclude_from_sim no)
		(at 25.4 17.78 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "31ad87b6-d7f5-426f-9f34-4a0eab23f0e7")
	)
	(text "Shunts: 0.025 ohm, 1%, 1 W. Nominal 4 A full scale at 100 mV.\nFuses remain 3 A; monitoring is not hardware current limiting.\nFirmware: apply PAC1934 low-rate REFRESH errata workaround.\nBoth supply bypass capacitors are drawn directly at their package pins."
		(exclude_from_sim no)
		(at 210.82 195.58 0)
